    {
      "parameters": {
        "jsCode": "// Suchtext der Anfrage (kommt aus dem IF \"sensibel?\")\nconst text = ($('If').first().json.suchtext || '').toLowerCase();\n\n// Füllwörter ignorieren\nconst stopp = ['der','die','das','und','nicht','nit','ist','geht','kommt','mit','bei',\n  'von','ein','eine','ich','mein','meine','kein','keine','mehr','auch','wird','im','in'];\nconst anfrageWoerter = text.split(/[^a-z0-9äöüß-]+/)\n  .filter(w => w.length >= 3 && !stopp.includes(w));\n\n// Notion-Spalte über Namensteil finden (Simplify benennt die Spalten um)\nconst feld = (p, teil) => {\n  const k = Object.keys(p).find(k => k.toLowerCase().includes(teil));\n  return k ? String(p[k] ?? '').toLowerCase() : '';\n};\n\nconst kandidaten = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  if (!p.id) continue; // leeres Item = nichts gefunden\n\n  const schlagwoerter = feld(p, 'schlag').split(/[,;]/).map(w => w.trim()).filter(Boolean);\n  const kontext = [feld(p, 'name'), feld(p, 'titel'), feld(p, 'fehlerbild'), feld(p, 'kategorie')].join(' ');\n\n  let score = 0;\n  const gefunden = [];\n  for (const sw of schlagwoerter) {               // Schlagwort steht in der Anfrage: +2\n    if (text.includes(sw)) { score += 2; gefunden.push(sw); }\n  }\n  for (const w of anfrageWoerter) {               // Anfragewort steht in Titel/Fehlerbild: +1\n    if (kontext.includes(w) && !gefunden.includes(w)) { score += 1; gefunden.push(w); }\n  }\n  kandidaten.push({ ...p, score, gefunden });\n}\n\nkandidaten.sort((a, b) => b.score - a.score);\n\nconst top3 = kandidaten.filter(k => k.score > 0).slice(0, 3);   // immer bis zu 3 anzeigen\nconst treffer = (top3[0]?.score ?? 0) >= 2;                     // Treffer nur ab Score 2\n\nreturn [{\n  json: {\n    treffer,\n    anzahl: top3.length,\n    top3_liste: top3.map((k, i) =>\n      `${i + 1}. ${k.name} (Score ${k.score}: ${k.gefunden.join(', ')})`).join('\\n'),\n    top3: top3.map(k => ({\n      name: k.name,\n      score: k.score,\n      gefunden: k.gefunden,\n      fehlerbild: k.property_fehlerbild,\n      loesung: k.property_lösung_schritte,\n      eskalation: k.property_eskalation_wenn,\n      url: k.url\n    }))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        128
